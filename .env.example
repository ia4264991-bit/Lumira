# Copy this file to .env (which is gitignored) and adjust values as needed.
# These are LOCAL DEVELOPMENT placeholders only — never commit real
# credentials, and never reuse these values anywhere but a local dev machine.
#
# Both docker-compose.yml and the Spring Boot app (application.yml) read
# these same variable names, so one .env file drives both.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumira
DB_USER=lumira_dev
DB_PASSWORD=change_me_locally

PGADMIN_EMAIL=dev@lumira.local
PGADMIN_PASSWORD=change_me_locally
PGADMIN_PORT=5050
